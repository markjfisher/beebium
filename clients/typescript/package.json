{
  "name": "beebium",
  "version": "0.1.0",
  "description": "TypeScript client for the Beebium BBC Micro emulator",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'tests/*integration*'",
    "test:integration": "vitest run tests/*integration*",
    "test:watch": "vitest",
    "generate-protos": "bash scripts/generate-protos.sh"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.0",
    "ts-proto": "^1.176.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "src"
  ]
}
