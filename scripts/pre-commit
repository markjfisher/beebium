#!/bin/bash
#
# Pre-commit hook to verify Beebium copyright notices are present in source files
# and automatically update the copyright year to the current year.
#
# Checks staged .swift, .h, .c, .hpp, .cpp files for the required copyright notice.
# If the notice exists but has an outdated year, updates it and re-stages the file.

# Get current year
current_year=$(date +%Y)

# Get list of staged files (excluding deleted files)
staged_files=$(git diff --cached --name-only --diff-filter=d)

# Track files missing copyright
missing_copyright=()

# Track files with updated year
updated_year=()

for file in $staged_files; do
    # Check file extension
    case "$file" in
        *.swift|*.h|*.c|*.hpp|*.cpp)
            # Skip generated protobuf files
            if [[ "$file" == *"/Generated/"* ]]; then
                continue
            fi

            # Skip third-party libraries (they have their own licenses)
            if [[ "$file" == *"/third_party/"* ]]; then
                continue
            fi

            # Check for Beebium copyright notice
            if ! grep -q "This file is part of Beebium" "$file" 2>/dev/null; then
                missing_copyright+=("$file")
            else
                # File has copyright notice - check if year needs updating
                # Match "Copyright © YYYY" or "Copyright (C) YYYY" pattern
                if grep -qE "Copyright (©|\(C\)) [0-9]{4} Robert Smallshire" "$file" 2>/dev/null; then
                    # Extract the year from the copyright line
                    file_year=$(grep -oE "Copyright (©|\(C\)) [0-9]{4}" "$file" | grep -oE "[0-9]{4}" | head -1)

                    if [ -n "$file_year" ] && [ "$file_year" != "$current_year" ]; then
                        # Update the year in the file
                        sed -i '' "s/Copyright © $file_year Robert Smallshire/Copyright © $current_year Robert Smallshire/g" "$file"
                        sed -i '' "s/Copyright (C) $file_year Robert Smallshire/Copyright © $current_year Robert Smallshire/g" "$file"

                        # Re-stage the file with updated year
                        git add "$file"
                        updated_year+=("$file")
                    fi
                fi
            fi
            ;;
    esac
done

# Report files with updated copyright year
if [ ${#updated_year[@]} -ne 0 ]; then
    echo "Updated copyright year to $current_year in:"
    for file in "${updated_year[@]}"; do
        echo "  $file"
    done
    echo ""
fi

# Report and fail if any files are missing copyright
if [ ${#missing_copyright[@]} -ne 0 ]; then
    echo "ERROR: The following files are missing the Beebium copyright notice:"
    echo ""
    for file in "${missing_copyright[@]}"; do
        echo "  $file"
    done
    echo ""
    echo "Please add the following notice at the top of each file:"
    echo ""
    echo "  // Copyright © $current_year Robert Smallshire <robert@smallshire.org.uk>"
    echo "  //"
    echo "  // This file is part of Beebium."
    echo "  //"
    echo "  // Beebium is free software: you can redistribute it and/or modify it under the terms of the"
    echo "  // GNU General Public License as published by the Free Software Foundation, either version 3 of the"
    echo "  // License, or (at your option) any later version. Beebium is distributed in the hope that it will"
    echo "  // be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or"
    echo "  // FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License for more details."
    echo "  // You should have received a copy of the GNU General Public License along with Beebium."
    echo "  // If not, see <https://www.gnu.org/licenses/>."
    echo ""
    exit 1
fi

exit 0
