10 *ADFS
20 REM Test file access and locking
30 *CDIR TESTA
40 *DIR TESTA
50 F%=OPENOUT("LOCK")
60 PRINT#F%,"data"
70 CLOSE#F%
80 *INFO LOCK
90 PRINT "TEST:DEFAULT-WR:PASS"
100 *ACCESS LOCK L
110 PRINT "TEST:SET-LOCK:PASS"
120 ON ERROR GOTO 150
130 *DELETE LOCK
140 PRINT "TEST:DEL-LOCKED:FAIL":GOTO 160
150 PRINT "TEST:DEL-LOCKED:PASS"
160 ON ERROR OFF
170 *ACCESS LOCK
180 *DELETE LOCK
190 PRINT "TEST:UNLOCK-DEL:PASS"
200 PRINT "DONE"
