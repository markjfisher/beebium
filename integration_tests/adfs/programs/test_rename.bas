10 *ADFS
20 REM Test *RENAME including cross-directory
30 *CDIR TSTD1
40 *CDIR TSTD2
50 *DIR TSTD1
60 F%=OPENOUT("SRC")
70 PRINT#F%,"data"
80 CLOSE#F%
90 *RENAME SRC DST
100 ON ERROR GOTO 130
110 F%=OPENIN("SRC"):CLOSE#F%
120 PRINT "TEST:OLD-GONE:FAIL":GOTO 140
130 PRINT "TEST:OLD-GONE:PASS"
140 ON ERROR OFF
150 F%=OPENIN("DST"):CLOSE#F%
160 PRINT "TEST:NEW-EXISTS:PASS"
170 *DIR $
180 *RENAME TSTD1.DST TSTD2.MOVED
190 PRINT "TEST:CROSS-DIR:PASS"
200 PRINT "DONE"
