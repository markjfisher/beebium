10 *ADFS
20 REM Test *RENAME including cross-directory
30 *CDIR TSTD1
40 *CDIR TSTD2
50 *DIR TSTD1
60 F%=OPENOUT("SRC")
70 PRINT#F%,"data"
80 CLOSE#F%
90 *RENAME SRC DST
100 F%=OPENIN("SRC")
110 IF F%=0 THEN PRINT "TEST:OLD-GONE:PASS" ELSE CLOSE#F%:PRINT "TEST:OLD-GONE:FAIL"
120 F%=OPENIN("DST")
130 IF F%<>0 THEN CLOSE#F%:PRINT "TEST:NEW-EXISTS:PASS" ELSE PRINT "TEST:NEW-EXISTS:FAIL"
140 *DIR $
150 *RENAME TSTD1.DST TSTD2.MOVED
160 PRINT "TEST:CROSS-DIR:PASS"
170 PRINT "DONE"
